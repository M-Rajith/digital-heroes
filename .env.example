# ---------- Database (Supabase Postgres) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_heroes?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/digital_heroes?schema=public"

# ---------- API ----------
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-in-production-32+chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# ---------- Stripe ----------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."
# Portion of each subscription that funds the prize pool (e.g. 0.20 = 20%)
PRIZE_POOL_RATE="0.20"
MONTHLY_PRICE_CENTS="999"     # used for pool math when price metadata unavailable
YEARLY_PRICE_CENTS="9990"

# ---------- Supabase (Storage for winner proofs) ----------
SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_STORAGE_BUCKET="winner-proofs"

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://xyz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
